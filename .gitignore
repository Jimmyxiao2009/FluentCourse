# Build outputs
bin/
obj/
out/

# IDE / editor
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs

# .NET
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# OS
Thumbs.db
.DS_Store
desktop.ini

# Sample / build artifacts (the unpacked directory is the source of truth;
# these are regenerated by Compress-Archive)
samples/**/*.fcourse.zip
samples/**/assets.zip

# Logs / temp
*.log
*.tmp

# MSIX packaging output and signing keys.
# 私钥(*.pfx)绝不入库;82MB 的 .msix 产物按需重新构建。
# 公开证书 build/*.cer 可保留以便目标机器导入信任(已显式取消忽略)。
build/msix/
build/**/*.pfx
*.pfx
!build/*.cer
