<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 装饰背景 ============ -->
    <Rectangle Width="760" Height="760"
               HorizontalAlignment="Right" VerticalAlignment="Center"
               Margin="0,0,-180,0"
               RadiusX="380" RadiusY="380"
               Fill="#3300B4D8" Opacity="0.5"/>
    <Rectangle Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Fill="#FF00B4D8" Opacity="0.9"/>

    <!-- ============ 标题块 ============ -->
    <StackPanel Grid.Row="0"
                VerticalAlignment="Center" HorizontalAlignment="Left"
                Margin="140,0,0,0" Spacing="14">
        <Border Background="#3300B4D8" BorderBrush="#FF00B4D8" BorderThickness="1"
                CornerRadius="4" Padding="16,8" HorizontalAlignment="Left">
            <TextBlock Text="实战" FontSize="20" FontWeight="SemiBold" Foreground="#FF00B4D8"/>
        </Border>
        <TextBlock Text="拆解 Wordie" FontSize="92" FontWeight="SemiBold" Foreground="#FFF5F7FB"/>
        <Rectangle Width="120" Height="3" Fill="#FF252D48" HorizontalAlignment="Left" Margin="0,16,0,0"/>
        <TextBlock TextWrapping="Wrap" MaxWidth="1100" FontSize="26" Foreground="#FFC7CEDD" LineHeight="40" Margin="0,8,0,0">
            <Run Text="Wordie 是我用 AI 做的一个" />
            <Run Text="跨平台背单词游戏" Foreground="#FF00B4D8" FontWeight="SemiBold"/>
            <Run Text="（电脑 / 安卓 / 苹果都能跑，三种玩法）。下面把这个真成品，对应到前面讲的每一步。"/>
        </TextBlock>
    </StackPanel>

    <!-- ============ CTA ============ -->
    <Button x:Name="DemoNext" Grid.Row="1"
            Content="看它怎么做出来  ▶"
            FontSize="22" Padding="40,16"
            Margin="0,0,140,80"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Background="#FF00B4D8" Foreground="White"
            CornerRadius="10" BorderThickness="0"/>
</Grid>
