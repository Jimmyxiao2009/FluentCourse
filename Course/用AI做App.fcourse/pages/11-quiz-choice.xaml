<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fc="using:FluentCourse.Runtime.Controls"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- =================== HeaderStrip =================== -->
    <Grid Grid.Row="0" Margin="100,72,100,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#338B5CF6" BorderBrush="#FF8B5CF6"
                BorderThickness="1" CornerRadius="4" Padding="14,6">
            <TextBlock Text="练习" FontSize="16" FontWeight="SemiBold" Foreground="#FF8B5CF6"/>
        </Border>
        <TextBlock Grid.Column="1" Text="随堂检测  ·  选择题" FontSize="40" FontWeight="SemiBold"
                   Foreground="#FFF5F7FB" VerticalAlignment="Center" Margin="20,0,0,0"/>
        <TextBlock Grid.Column="2" Text="11 / 13" FontSize="16"
                   Foreground="#FF8893AC" VerticalAlignment="Center"/>
    </Grid>
    <Rectangle Grid.Row="0" Height="1" Margin="100,16,100,0"
               VerticalAlignment="Bottom" Fill="#FF252D48"/>

    <!-- =================== Body =================== -->
    <ScrollViewer Grid.Row="1" Margin="100,40,100,60" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="1200" HorizontalAlignment="Center">

            <fc:QuizControl x:Name="Quiz1" Mode="Single" AllowRetry="True"
                            ScoreStrategy="AllOrNothing"
                            Question="1. 给 AI 提需求时，哪种说法最可能让它做出你想要的东西？">
                <fc:QuizControl.Choices>
                    <fc:QuizChoice Text="A. 做个好用的 App"/>
                    <fc:QuizChoice Text="B. 一个背单词游戏，三种玩法：填字/找词/翻字母，词库内置不用联网" IsAnswer="True"
                                   Feedback="正确！"
                                   Explanation="把模糊想法写成具体的「用户故事」，说清谁用、能做什么、长什么样，AI 才知道往哪做。给上下文比措辞技巧更重要。"/>
                    <fc:QuizChoice Text="C. 随便做做，你看着办"/>
                    <fc:QuizChoice Text="D. 越快越好，先给我"/>
                </fc:QuizControl.Choices>
            </fc:QuizControl>

            <fc:QuizControl x:Name="Quiz2" Mode="Single" AllowRetry="True"
                            ScoreStrategy="AllOrNothing"
                            Question="2. 新手第一次用 AI 做 App，技术栈更推荐选哪个？">
                <fc:QuizControl.Choices>
                    <fc:QuizChoice Text="A. 越小众越好，显得厉害"/>
                    <fc:QuizChoice Text="B. AI 语料最多的主流栈（如网页前端）" IsAnswer="True"
                                   Feedback="正确！"
                                   Explanation="主流栈 AI 见得多，写得又快又对；小众栈（如 WinUI 3）AI 出错率明显更高。Wordie 选 Web+Tauri 就是这个道理。"/>
                    <fc:QuizChoice Text="C. 必须用刚发布的最新框架"/>
                    <fc:QuizChoice Text="D. 哪个名字好听选哪个"/>
                </fc:QuizControl.Choices>
            </fc:QuizControl>

            <fc:QuizControl x:Name="Quiz3" Mode="Single" AllowRetry="True"
                            ScoreStrategy="AllOrNothing"
                            Question="3. AI 写的代码报错了，最有效的求助方式是？">
                <fc:QuizControl.Choices>
                    <fc:QuizChoice Text="A. 只说一句：报错了，帮我修"/>
                    <fc:QuizChoice Text="B. 完整报错 + 复现步骤 + 你期望的行为" IsAnswer="True"
                                   Feedback="正确！这就是「喂错三件套」。"
                                   Explanation="只说「报错了」AI 也只能猜。把完整报错、怎么复现、你期望的行为三件套都给齐，它才能精准定位。"/>
                    <fc:QuizChoice Text="C. 直接重启电脑"/>
                    <fc:QuizChoice Text="D. 换个 AI，再问一遍一模一样的话"/>
                </fc:QuizControl.Choices>
            </fc:QuizControl>

        </StackPanel>
    </ScrollViewer>
</Grid>
