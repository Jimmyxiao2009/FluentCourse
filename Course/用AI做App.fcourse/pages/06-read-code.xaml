<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- =================== HeaderStrip =================== -->
    <Grid Grid.Row="0" Margin="100,72,100,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#338B5CF6" BorderBrush="#FF8B5CF6"
                BorderThickness="1" CornerRadius="4" Padding="14,6">
            <TextBlock Text="方法" FontSize="16" FontWeight="SemiBold" Foreground="#FF8B5CF6"/>
        </Border>
        <TextBlock Grid.Column="1" Text="四、看懂代码" FontSize="40" FontWeight="SemiBold"
                   Foreground="#FFF5F7FB" VerticalAlignment="Center" Margin="20,0,0,0"/>
        <TextBlock Grid.Column="2" Text="6 / 13" FontSize="16"
                   Foreground="#FF8893AC" VerticalAlignment="Center"/>
    </Grid>
    <Rectangle Grid.Row="0" Height="1" Margin="100,16,100,0"
               VerticalAlignment="Bottom" Fill="#FF252D48"/>

    <!-- =================== Body =================== -->
    <Grid Grid.Row="1" Margin="100,40,100,60">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="3,1,1,1" CornerRadius="10"
                BorderBrush="#FF8B5CF6" Background="#FF1E2747" Padding="32,26" Margin="0,0,0,22">
            <TextBlock TextWrapping="Wrap" FontSize="30" Foreground="#FFF5F7FB" LineHeight="44">
                <Run Text="不用会写，" Foreground="#FF8B5CF6" FontWeight="SemiBold"/>
                <Run Text="但要会" />
                <Run Text="读个大概" Foreground="#FF8B5CF6" FontWeight="SemiBold"/>
                <Run Text="。"/>
            </TextBlock>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="1" CornerRadius="10" BorderBrush="#FFF59E0B"
                    Background="#FF161D33" Padding="28,24" Margin="0,0,11,0">
                <StackPanel Spacing="14">
                    <TextBlock Text="为什么不能全靠 AI" FontSize="24" FontWeight="SemiBold" Foreground="#FFF59E0B"/>
                    <TextBlock TextWrapping="Wrap" FontSize="21" Foreground="#FFC7CEDD" LineHeight="34"
                               Text="完全不看代码，一旦出问题，你连「哪儿坏了」都描述不清楚 —— 也就没法把问题说给 AI 听，越改越乱。"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" CornerRadius="10" BorderBrush="#FF22C55E"
                    Background="#FF161D33" Padding="28,24" Margin="11,0,0,0">
                <StackPanel Spacing="14">
                    <TextBlock Text="读不懂怎么办" FontSize="24" FontWeight="SemiBold" Foreground="#FF22C55E"/>
                    <TextBlock TextWrapping="Wrap" FontSize="21" Foreground="#FFC7CEDD" LineHeight="34">
                        <Run Text="让 AI " />
                        <Run Text="用大白话解释这个文件" Foreground="#FFF5F7FB" FontWeight="SemiBold"/>
                        <Run Text="、" />
                        <Run Text="画一张结构图" Foreground="#FFF5F7FB" FontWeight="SemiBold"/>
                        <Run Text="。看懂「东西分门别类放在哪」，就够你描述问题了。"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Grid>
