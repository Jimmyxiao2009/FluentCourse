<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fc="using:FluentCourse.Runtime.Controls"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- =================== HeaderStrip =================== -->
    <Grid Grid.Row="0" Margin="100,72,100,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#338B5CF6" BorderBrush="#FF8B5CF6"
                BorderThickness="1" CornerRadius="4" Padding="14,6">
            <TextBlock Text="方法 · 重点" FontSize="16" FontWeight="SemiBold" Foreground="#FF8B5CF6"/>
        </Border>
        <TextBlock Grid.Column="1" Text="五、调试与验证" FontSize="40" FontWeight="SemiBold"
                   Foreground="#FFF5F7FB" VerticalAlignment="Center" Margin="20,0,0,0"/>
        <TextBlock Grid.Column="2" Text="7 / 13" FontSize="16"
                   Foreground="#FF8893AC" VerticalAlignment="Center"/>
    </Grid>
    <Rectangle Grid.Row="0" Height="1" Margin="100,16,100,0"
               VerticalAlignment="Bottom" Fill="#FF252D48"/>

    <!-- =================== Body =================== -->
    <Grid Grid.Row="1" Margin="100,36,100,32">
        <fc:StepRevealControl x:Name="DebugReveal">
            <StackPanel Spacing="16">

                <!-- Step 1 -->
                <Border BorderThickness="3,1,1,1" CornerRadius="10" BorderBrush="#FF8B5CF6"
                        Background="#FF161D33" Padding="28,22">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="#FF8B5CF6" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="1" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="喂错误，给「三件套」" FontSize="28" FontWeight="SemiBold"
                                       Foreground="#FFF5F7FB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border BorderThickness="1" CornerRadius="6" BorderBrush="#FF3B4566" Background="#FF1E2747" Padding="18,12">
                                <TextBlock Text="① 完整报错" FontSize="20" Foreground="#FFF5F7FB"/>
                            </Border>
                            <Border BorderThickness="1" CornerRadius="6" BorderBrush="#FF3B4566" Background="#FF1E2747" Padding="18,12">
                                <TextBlock Text="② 复现步骤" FontSize="20" Foreground="#FFF5F7FB"/>
                            </Border>
                            <Border BorderThickness="1" CornerRadius="6" BorderBrush="#FF3B4566" Background="#FF1E2747" Padding="18,12">
                                <TextBlock Text="③ 你期望的行为" FontSize="20" Foreground="#FFF5F7FB"/>
                            </Border>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="19" Foreground="#FF8893AC" LineHeight="29"
                                   Text="只说「报错了帮我修」，AI 也只能猜。三件套齐了，它才能精准定位。"/>
                    </StackPanel>
                </Border>

                <!-- Step 2 -->
                <Border BorderThickness="3,1,1,1" CornerRadius="10" BorderBrush="#FF8B5CF6"
                        Background="#FF161D33" Padding="28,22">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="#FF8B5CF6" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="2" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="验证手段，必须你自己会" FontSize="28" FontWeight="SemiBold"
                                       Foreground="#FFF5F7FB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="20" Foreground="#FFC7CEDD" LineHeight="32">
                            <Run Text="AI 会" />
                            <Run Text="自信地写出错的代码" Foreground="#FF8B5CF6" FontWeight="SemiBold"/>
                            <Run Text="。所以你得会自己跑起来、会看日志 —— 比如崩溃日志写在 " />
                            <Run Text="%TEMP%\crash.log" FontFamily="Consolas, Cambria Math" Foreground="#FFF5F7FB"/>
                            <Run Text="，看一眼就知道哪炸了。" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Step 3 -->
                <Border BorderThickness="3,1,1,1" CornerRadius="10" BorderBrush="#FF8B5CF6"
                        Background="#FF161D33" Padding="28,22">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="#FF8B5CF6" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="3" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="陷入死循环时，这样破" FontSize="28" FontWeight="SemiBold"
                                       Foreground="#FFF5F7FB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="20" Foreground="#FFC7CEDD" LineHeight="32">
                            <Run Text="改了又坏、坏了又改？" />
                            <Run Text="换个问法" Foreground="#FF8B5CF6" FontWeight="SemiBold"/>
                            <Run Text=" / " />
                            <Run Text="缩小问题范围" Foreground="#FF8B5CF6" FontWeight="SemiBold"/>
                            <Run Text=" / " />
                            <Run Text="让 AI 先加日志定位" Foreground="#FF8B5CF6" FontWeight="SemiBold"/>
                            <Run Text="，别在同一个坑里反复横跳。"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </fc:StepRevealControl>
    </Grid>

    <!-- =================== FooterStrip =================== -->
    <Border Grid.Row="2" Margin="100,0,100,56"
            BorderBrush="#FF252D48" BorderThickness="0,1,0,0" Padding="0,20,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <TextBlock Text="点击按钮逐条展开"
                       Foreground="#FF8893AC" FontSize="16"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="DebugNext" Content="下一步  ▶"
                    FontSize="20" Padding="32,12"
                    Background="#FF8B5CF6" Foreground="White"
                    CornerRadius="8" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Grid>
