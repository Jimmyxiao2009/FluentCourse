<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- =================== HeaderStrip =================== -->
    <Grid Grid.Row="0" Margin="100,72,100,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#338B5CF6"
                BorderBrush="#FF8B5CF6" BorderThickness="1"
                CornerRadius="4" Padding="14,6">
            <TextBlock Text="开场" FontSize="16" FontWeight="SemiBold" Foreground="#FF8B5CF6"/>
        </Border>
        <TextBlock Grid.Column="1" Text="本课路线 · 七步走"
                   FontSize="40" FontWeight="SemiBold" Foreground="#FFF5F7FB"
                   VerticalAlignment="Center" Margin="20,0,0,0"/>
        <TextBlock Grid.Column="2" Text="2 / 13" FontSize="16"
                   Foreground="#FF8893AC" VerticalAlignment="Center"/>
    </Grid>
    <Rectangle Grid.Row="0" Height="1" Margin="100,16,100,0"
               VerticalAlignment="Bottom" Fill="#FF252D48"/>

    <!-- =================== Body =================== -->
    <Grid Grid.Row="1" Margin="100,32,100,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 承诺横幅 -->
        <Border Grid.Row="0" BorderThickness="3,1,1,1" CornerRadius="10"
                BorderBrush="#FF8B5CF6" Background="#FF1E2747"
                Padding="28,20" Margin="0,0,0,20">
            <TextBlock TextWrapping="Wrap" FontSize="22" Foreground="#FFF5F7FB" LineHeight="32">
                <Run Text="一句承诺：" Foreground="#FF8B5CF6" FontWeight="SemiBold"/>
                <Run Text="今天走完这七步，你就掌握了从「一个想法」到「一个能跑的产品」的完整路径。其中"/>
                <Run Text="第三步（提示词）和第五步（调试）" Foreground="#FF8B5CF6" FontWeight="SemiBold"/>
                <Run Text="最值钱，其余都是配套。"/>
            </TextBlock>
        </Border>

        <!-- 七步两列 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,12,0">
                <Border BorderThickness="1" CornerRadius="10" BorderBrush="#FF252D48" Background="#FF161D33" Padding="22,16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Background="#338B5CF6" CornerRadius="8" Width="46" Height="46" VerticalAlignment="Center">
                            <TextBlock Text="1" FontSize="22" FontWeight="SemiBold" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="需求构思" FontSize="22" FontWeight="SemiBold" Foreground="#FFF5F7FB"/>
                            <TextBlock Text="把模糊想法拆成可验证的小目标" FontSize="17" Foreground="#FF8893AC"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" CornerRadius="10" BorderBrush="#FF252D48" Background="#FF161D33" Padding="22,16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Background="#338B5CF6" CornerRadius="8" Width="46" Height="46" VerticalAlignment="Center">
                            <TextBlock Text="2" FontSize="22" FontWeight="SemiBold" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="技术选型" FontSize="22" FontWeight="SemiBold" Foreground="#FFF5F7FB"/>
                            <TextBlock Text="选 AI 最擅长的主流栈" FontSize="17" Foreground="#FF8893AC"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border BorderThickness="3,1,1,1" CornerRadius="10" BorderBrush="#FF8B5CF6" Background="#FF1E2747" Padding="22,16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Background="#FF8B5CF6" CornerRadius="8" Width="46" Height="46" VerticalAlignment="Center">
                            <TextBlock Text="3" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="和 AI 协作（提示词） · 重点" FontSize="22" FontWeight="SemiBold" Foreground="#FFF5F7FB"/>
                            <TextBlock Text="给上下文 比 措辞技巧更重要" FontSize="17" Foreground="#FFC7CEDD"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" CornerRadius="10" BorderBrush="#FF252D48" Background="#FF161D33" Padding="22,16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Background="#338B5CF6" CornerRadius="8" Width="46" Height="46" VerticalAlignment="Center">
                            <TextBlock Text="4" FontSize="22" FontWeight="SemiBold" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="看懂代码" FontSize="22" FontWeight="SemiBold" Foreground="#FFF5F7FB"/>
                            <TextBlock Text="不用会写，但要会读" FontSize="17" Foreground="#FF8893AC"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="14" Margin="12,0,0,0">
                <Border BorderThickness="3,1,1,1" CornerRadius="10" BorderBrush="#FF8B5CF6" Background="#FF1E2747" Padding="22,16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Background="#FF8B5CF6" CornerRadius="8" Width="46" Height="46" VerticalAlignment="Center">
                            <TextBlock Text="5" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="调试与验证 · 重点" FontSize="22" FontWeight="SemiBold" Foreground="#FFF5F7FB"/>
                            <TextBlock Text="喂错三件套，验证手段自己掌握" FontSize="17" Foreground="#FFC7CEDD"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" CornerRadius="10" BorderBrush="#FF252D48" Background="#FF161D33" Padding="22,16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Background="#338B5CF6" CornerRadius="8" Width="46" Height="46" VerticalAlignment="Center">
                            <TextBlock Text="6" FontSize="22" FontWeight="SemiBold" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="版本管理 git" FontSize="22" FontWeight="SemiBold" Foreground="#FFF5F7FB"/>
                            <TextBlock Text="改前存档，改坏回滚" FontSize="17" Foreground="#FF8893AC"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" CornerRadius="10" BorderBrush="#FF252D48" Background="#FF161D33" Padding="22,16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Background="#338B5CF6" CornerRadius="8" Width="46" Height="46" VerticalAlignment="Center">
                            <TextBlock Text="7" FontSize="22" FontWeight="SemiBold" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="发布与迭代" FontSize="22" FontWeight="SemiBold" Foreground="#FFF5F7FB"/>
                            <TextBlock Text="给别人用，收反馈再改" FontSize="17" Foreground="#FF8893AC"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" CornerRadius="10" BorderBrush="#3300B4D8" Background="#3300B4D8" Padding="22,16">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Border Background="#FF00B4D8" CornerRadius="8" Width="46" Height="46" VerticalAlignment="Center">
                            <TextBlock Text="★" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="实战：拆解 Wordie" FontSize="22" FontWeight="SemiBold" Foreground="#FFF5F7FB"/>
                            <TextBlock Text="用真成品把七步走一遍" FontSize="17" Foreground="#FFC7CEDD"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>

    <!-- =================== FooterStrip =================== -->
    <Border Grid.Row="2" Margin="100,0,100,56"
            BorderBrush="#FF252D48" BorderThickness="0,1,0,0" Padding="0,20,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <TextBlock Text="先从「想清楚要什么」开始"
                       Foreground="#FF8893AC" FontSize="16"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="RoadmapNext" Content="进入第一步  ▶"
                    FontSize="20" Padding="32,12"
                    Background="#FF8B5CF6" Foreground="White"
                    CornerRadius="8" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Grid>
