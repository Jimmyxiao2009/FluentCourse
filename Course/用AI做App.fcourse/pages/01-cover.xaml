<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 装饰背景 ============ -->
    <Rectangle Width="720" Height="720"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-160,-160,0"
               RadiusX="360" RadiusY="360"
               Fill="#338B5CF6" Opacity="0.5"/>
    <Rectangle Width="420" Height="420"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,120,120"
               RadiusX="210" RadiusY="210"
               Fill="#3300B4D8" Opacity="0.4"/>

    <!-- ============ 左侧主题色光带 ============ -->
    <Rectangle Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Fill="#FF8B5CF6" Opacity="0.9"/>

    <!-- ============ 标题块 ============ -->
    <StackPanel Grid.Row="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Margin="140,0,0,0"
                Spacing="10">

        <TextBlock x:Name="EyebrowText"
                   Text="30 分钟实战 · 零基础友好"
                   FontSize="30"
                   FontWeight="Light"
                   Foreground="#FF8B5CF6"
                   Opacity="0"/>

        <TextBlock x:Name="TitleMain"
                   Text="用 AI 做出"
                   FontSize="110"
                   FontWeight="SemiBold"
                   Foreground="#FFF5F7FB"
                   Opacity="0"/>

        <TextBlock x:Name="TitleAccent"
                   Text="你想要的 App"
                   FontSize="110"
                   FontWeight="SemiBold"
                   Foreground="#FF8B5CF6"
                   Opacity="0"/>

        <Rectangle Width="120" Height="3"
                   Fill="#FF252D48"
                   HorizontalAlignment="Left"
                   Margin="0,32,0,0"/>

        <TextBlock x:Name="Subtitle"
                   Text="从一句想法  →  一个能跑、能装进手机的产品"
                   FontSize="26"
                   Foreground="#FFC7CEDD"
                   Margin="0,12,0,0"
                   Opacity="0"/>

        <TextBlock x:Name="MetaBlock"
                   Text="需求构思   ·   技术选型   ·   提示词   ·   调试验证   ·   发布迭代"
                   FontSize="18"
                   Foreground="#FF8893AC"
                   Margin="0,16,0,0"
                   Opacity="0"/>
    </StackPanel>

    <!-- ============ CTA 按钮 ============ -->
    <Button x:Name="StartButton"
            Grid.Row="1"
            Content="开始上课  →"
            FontSize="22"
            Padding="48,16"
            Margin="0,0,140,80"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#FF8B5CF6"
            Foreground="White"
            CornerRadius="10"
            BorderThickness="0"
            Opacity="0"/>
</Grid>
