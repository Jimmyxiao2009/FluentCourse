<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF0E1424">

    <!-- ============ 装饰背景 ============ -->
    <Rectangle Width="820" Height="820"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RadiusX="410" RadiusY="410"
               Fill="#338B5CF6" Opacity="0.35"/>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxWidth="1400" Spacing="20">

        <TextBlock Text="收尾" FontSize="22" FontWeight="Light" Foreground="#FF8B5CF6"
                   HorizontalAlignment="Center"/>

        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="68" FontWeight="SemiBold"
                   Foreground="#FFF5F7FB" LineHeight="86">
            <Run Text="AI 不是替你做，是" />
            <Run Text="放大你" Foreground="#FF8B5CF6"/>
            <Run Text="。"/>
        </TextBlock>

        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="26" Foreground="#FFC7CEDD"
                   LineHeight="40" Margin="0,8,0,0"
                   Text="你得知道自己要什么、怎么把它说清楚、怎么验证它对不对。"/>

        <Rectangle Width="160" Height="3" Fill="#FF252D48" HorizontalAlignment="Center" Margin="0,16,0,16"/>

        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="24" Foreground="#FF8893AC" LineHeight="38"
                   Text="需求 → 选型 → 提示词 → 看懂代码 → 调试 → 存档 → 发布"/>

        <Border BorderThickness="1" CornerRadius="10" BorderBrush="#FF8B5CF6" Background="#FF1E2747"
                Padding="32,22" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="24" Foreground="#FFF5F7FB" LineHeight="36">
                <Run Text="回去，挑一个" />
                <Run Text="你自己想要的小东西" Foreground="#FF8B5CF6" FontWeight="SemiBold"/>
                <Run Text="，把这七步走一遍。"/>
            </TextBlock>
        </Border>

    </StackPanel>
</Grid>
