<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- =================== HeaderStrip =================== -->
    <Grid Grid.Row="0" Margin="100,72,100,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#338B5CF6" BorderBrush="#FF8B5CF6"
                BorderThickness="1" CornerRadius="4" Padding="14,6">
            <TextBlock Text="方法" FontSize="16" FontWeight="SemiBold" Foreground="#FF8B5CF6"/>
        </Border>
        <TextBlock Grid.Column="1" Text="二、技术选型" FontSize="40" FontWeight="SemiBold"
                   Foreground="#FFF5F7FB" VerticalAlignment="Center" Margin="20,0,0,0"/>
        <TextBlock Grid.Column="2" Text="4 / 13" FontSize="16"
                   Foreground="#FF8893AC" VerticalAlignment="Center"/>
    </Grid>
    <Rectangle Grid.Row="0" Height="1" Margin="100,16,100,0"
               VerticalAlignment="Bottom" Fill="#FF252D48"/>

    <!-- =================== Body =================== -->
    <Grid Grid.Row="1" Margin="100,36,100,56">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 核心观念 -->
        <Border Grid.Row="0" BorderThickness="3,1,1,1" CornerRadius="10"
                BorderBrush="#FF8B5CF6" Background="#FF1E2747" Padding="28,22" Margin="0,0,0,20">
            <TextBlock TextWrapping="Wrap" FontSize="24" Foreground="#FFF5F7FB" LineHeight="36">
                <Run Text="新手优先选 AI 语料最多的主流栈。" Foreground="#FF8B5CF6" FontWeight="SemiBold"/>
                <Run Text="AI 见得多的技术，它写得又快又对；越小众，出错率越高。"/>
            </TextBlock>
        </Border>

        <!-- 平台选项 chips -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Margin="0,0,0,22">
            <Border BorderThickness="1" CornerRadius="8" BorderBrush="#FF22C55E" Background="#3322C55E" Padding="20,12">
                <TextBlock Text="网页 · 最推荐" FontSize="19" FontWeight="SemiBold" Foreground="#FF22C55E"/>
            </Border>
            <Border BorderThickness="1" CornerRadius="8" BorderBrush="#FF252D48" Background="#FF161D33" Padding="20,12">
                <TextBlock Text="桌面" FontSize="19" Foreground="#FFC7CEDD"/>
            </Border>
            <Border BorderThickness="1" CornerRadius="8" BorderBrush="#FF252D48" Background="#FF161D33" Padding="20,12">
                <TextBlock Text="小程序" FontSize="19" Foreground="#FFC7CEDD"/>
            </Border>
            <Border BorderThickness="1" CornerRadius="8" BorderBrush="#FF252D48" Background="#FF161D33" Padding="20,12">
                <TextBlock Text="手机 App" FontSize="19" Foreground="#FFC7CEDD"/>
            </Border>
        </StackPanel>

        <!-- 正反案例 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="1" CornerRadius="10"
                    BorderBrush="#FF22C55E" Background="#FF161D33" Padding="26,22" Margin="0,0,11,0">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="#3322C55E" CornerRadius="6" Width="40" Height="40">
                            <TextBlock Text="✓" FontSize="22" FontWeight="SemiBold" Foreground="#FF22C55E"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="正面 · Wordie" FontSize="24" FontWeight="SemiBold"
                                   Foreground="#FF22C55E" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="20" Foreground="#FFC7CEDD" LineHeight="32">
                        <Run Text="界面用 " /><Run Text="网页技术（HTML/CSS/JS）" Foreground="#FFF5F7FB" FontWeight="SemiBold"/>
                        <Run Text="写，再用 " /><Run Text="Tauri" Foreground="#FFF5F7FB" FontWeight="SemiBold"/>
                        <Run Text=" 一打包 —— " /><Run Text="一套代码出 Windows / 安卓 / 苹果" Foreground="#FF22C55E" FontWeight="SemiBold"/>
                        <Run Text="。AI 写得又快又稳。"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" CornerRadius="10"
                    BorderBrush="#FFF59E0B" Background="#FF161D33" Padding="26,22" Margin="11,0,0,0">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="#33F59E0B" CornerRadius="6" Width="40" Height="40">
                            <TextBlock Text="✗" FontSize="22" FontWeight="SemiBold" Foreground="#FFF59E0B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="反面 · 别学我" FontSize="24" FontWeight="SemiBold"
                                   Foreground="#FFF59E0B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="20" Foreground="#FFC7CEDD" LineHeight="32">
                        <Run Text="我另一个项目 FluentCourse 选了 " />
                        <Run Text="WinUI 3" Foreground="#FFF5F7FB" FontWeight="SemiBold"/>
                        <Run Text=" 这种小众技术，" />
                        <Run Text="AI 出错率明显更高" Foreground="#FFF59E0B" FontWeight="SemiBold"/>
                        <Run Text="，连编译都得记住一堆特殊参数。入门别走这条路。"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Grid>
