<?xml version="1.0" encoding="utf-8"?>
<!--
  用 AI 做出你自己想要的 App · 视觉令牌字典 v1
  说明：当前 XamlReader 不消费资源引用，页面以字面量值同步。
  改令牌时请同时更新本文件与所有 pages/*.xaml。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =================== 背景与表面 =================== -->
    <SolidColorBrush x:Key="BgStage"        Color="#FF0E1424"/>
    <SolidColorBrush x:Key="BgPage"         Color="#FF0E1424"/>
    <SolidColorBrush x:Key="BgElevated"     Color="#FF161D33"/>
    <SolidColorBrush x:Key="BgElevated2"    Color="#FF1E2747"/>

    <!-- =================== 边框 =================== -->
    <SolidColorBrush x:Key="BorderSubtle"   Color="#FF252D48"/>
    <SolidColorBrush x:Key="BorderStrong"   Color="#FF3B4566"/>

    <!-- =================== 文字 =================== -->
    <SolidColorBrush x:Key="TextPrimary"    Color="#FFF5F7FB"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="#FFC7CEDD"/>
    <SolidColorBrush x:Key="TextMuted"      Color="#FF8893AC"/>

    <!-- =================== 主题强调色 =================== -->
    <!-- 方法论章节（开场/方法/练习/收尾）= 紫 -->
    <SolidColorBrush x:Key="AccentMethod"     Color="#FF8B5CF6"/>
    <SolidColorBrush x:Key="AccentMethodSoft" Color="#338B5CF6"/>
    <!-- 实战章节（Wordie 拆解）= 青 -->
    <SolidColorBrush x:Key="AccentDemo"       Color="#FF00B4D8"/>
    <SolidColorBrush x:Key="AccentDemoSoft"   Color="#3300B4D8"/>
    <!-- 行内对比 -->
    <SolidColorBrush x:Key="AccentSuccess"    Color="#FF22C55E"/>
    <SolidColorBrush x:Key="AccentSuccessSoft" Color="#3322C55E"/>
    <SolidColorBrush x:Key="AccentWarning"    Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="AccentWarningSoft" Color="#33F59E0B"/>

    <!-- =================== 字体 =================== -->
    <x:String x:Key="FontMono">Consolas, Cambria Math, monospace</x:String>

    <!-- =================== 间距（Double） =================== -->
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">16</x:Double>
    <x:Double x:Key="SpaceL">24</x:Double>
    <x:Double x:Key="SpaceXl">32</x:Double>

    <!-- =================== 通用内边距 =================== -->
    <Thickness x:Key="PaddingContent">100,72,100,72</Thickness>
    <Thickness x:Key="PaddingCard">28,22</Thickness>

    <!-- =================== 圆角 =================== -->
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">4</CornerRadius>

</ResourceDictionary>
