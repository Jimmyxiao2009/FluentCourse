<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF1A1A2E"
      Padding="100,60,100,60">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="三、油脂的应用"
               FontSize="48" FontWeight="SemiBold" Foreground="White"
               Margin="0,0,0,40"/>

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border BorderThickness="1" CornerRadius="10" Margin="0,0,20,0"
                BorderBrush="#FF2A2A4A" Padding="28,24"
                Background="#FF16162E">
            <StackPanel Spacing="12">
                <TextBlock Text="🍳" FontSize="36"/>
                <TextBlock Text="营养与烹饪" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FFAAAAAA" LineHeight="28"
                           Text="油脂是热值最高的营养物质（1g ≈ 39kJ）。烹饪中作热介质产生特有风味。适量摄入，过量影响健康。"/>
            </StackPanel>
        </Border>

        <Border BorderThickness="1" CornerRadius="10" Margin="0,0,20,0"
                BorderBrush="#FF2A2A4A" Padding="28,24"
                Background="#FF16162E">
            <StackPanel Spacing="12">
                <TextBlock Text="🧼" FontSize="36"/>
                <TextBlock Text="化工原料" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FFAAAAAA" LineHeight="28"
                           Text="皂化反应制肥皂、甘油。氢化植物油制人造奶油、起酥油。甘油广泛用于化妆品、药品、炸药。"/>
            </StackPanel>
        </Border>

        <Border BorderThickness="1" CornerRadius="10"
                BorderBrush="#FF2A2A4A" Padding="28,24"
                Background="#FF16162E">
            <StackPanel Spacing="12">
                <TextBlock Text="🔧" FontSize="36"/>
                <TextBlock Text="其他用途" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FFAAAAAA" LineHeight="28"
                           Text="涂料、润滑油、生物柴油（油脂甲酯化）、表面活性剂等。是重要的可再生生物质资源。"/>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
