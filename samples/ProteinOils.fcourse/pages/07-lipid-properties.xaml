<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fc="using:FluentCourse.Runtime.Controls"
      Background="#FF1A1A2E"
      Padding="100">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="二、油脂的化学性质"
               FontSize="48" FontWeight="SemiBold" Foreground="White"
               Margin="0,0,0,30"/>

    <fc:StepRevealControl x:Name="LipidReveal" Grid.Row="1">
        <!-- 反应 1: 加成（氢化） -->
        <Border BorderThickness="1" CornerRadius="10"
                BorderBrush="#FF2A2A4A" Padding="28,24" Margin="0,0,0,16"
                Background="#FF16162E">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Background="#FFE94560" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="1" FontSize="16" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="加成反应 — 油脂的氢化" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
                <Border Background="#1A0F3460" Padding="20,14" CornerRadius="6" Margin="0,8,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="液态植物油 + H₂  ——Ni/Δ→  固态脂肪（氢化植物油/人造奶油）"
                                   FontSize="20" Foreground="#FFCCCCCC" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FF8888AA" Margin="0,4,0,0">
                    不饱和脂肪酸的碳碳双键与H₂发生加成反应（催化加氢），使液态油转变为固态脂肪。
                    氢化植物油稳定性好、便于运输和储存。
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 反应 2: 水解（皂化） -->
        <Border BorderThickness="1" CornerRadius="10"
                BorderBrush="#FF2A2A4A" Padding="28,24"
                Background="#FF16162E">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Background="#FF0F3460" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="2" FontSize="16" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="水解反应 — 皂化反应" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
                <Border Background="#1A0F3460" Padding="20,14" CornerRadius="6" Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="酸性条件：油脂 + H₂O  ——酸/酶→  高级脂肪酸 + 甘油"
                                   FontSize="20" Foreground="#FFCCCCCC"/>
                        <TextBlock Text="碱性条件：油脂 + NaOH  ——Δ→  高级脂肪酸钠（肥皂）+ 甘油"
                                   FontSize="20" Foreground="#FFE94560" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FF8888AA" Margin="0,4,0,0">
                    碱性条件下的水解反应称为<Run Text="皂化反应" Foreground="#FFE94560" FontWeight="SemiBold"/>。
                    产物中的高级脂肪酸钠是<Run Text="肥皂的主要成分" Foreground="#FF00D2FF"/>。
                </TextBlock>
            </StackPanel>
        </Border>
    </fc:StepRevealControl>

    <Border Grid.Row="2" BorderBrush="#FF2A2A4A" BorderThickness="0,1,0,0" Padding="0,16,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <TextBlock Text="点击逐步显示反应" Foreground="#FF8888AA" FontSize="16" VerticalAlignment="Center"/>
            <Button x:Name="LipidNext"
                    Content="下一步 ▶"
                    FontSize="18" Padding="24,10"
                    Background="#FF0F3460" Foreground="White"
                    CornerRadius="6" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Grid>
