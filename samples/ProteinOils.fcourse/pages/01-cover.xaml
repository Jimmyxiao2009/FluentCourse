<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 主视觉：实验室照片（深色蒙层） ============ -->
    <Grid>
        <Image Source="ms-fcourse:///assets/image1.jpeg"
               Stretch="UniformToFill"
               Opacity="0.55"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>
        <Rectangle Fill="#FF0E1424" Opacity="0.45"/>
    </Grid>

    <!-- ============ 装饰：左侧暖色光带 ============ -->
    <Rectangle Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Fill="#FFE94560" Opacity="0.9"/>

    <!-- ============ 标题块 ============ -->
    <StackPanel Grid.Row="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Margin="140,0,0,0"
                Spacing="12">

        <TextBlock x:Name="EyebrowText"
                   Text="7.4.2"
                   FontSize="32"
                   FontWeight="Light"
                   Foreground="#FFE94560"
                   Opacity="0"/>

        <TextBlock x:Name="TitleMain"
                   Text="蛋白质"
                   FontSize="128"
                   FontWeight="SemiBold"
                   Foreground="#FFF5F7FB"
                   Opacity="0"/>

        <TextBlock x:Name="TitleAccent"
                   Text="油  脂"
                   FontSize="128"
                   FontWeight="SemiBold"
                   Foreground="#FF00B4D8"
                   Opacity="0"/>

        <Rectangle Width="120" Height="3"
                   Fill="#FF252D48"
                   Margin="0,32,0,0"/>

        <TextBlock x:Name="Subtitle"
                   Text="人教版 · 高中化学 · 必修第二册"
                   FontSize="24"
                   Foreground="#FFC7CEDD"
                   Margin="0,8,0,0"
                   Opacity="0"/>

        <TextBlock x:Name="MetaBlock"
                   Text="Chapter 7   ·   第四节   ·   化学与生活"
                   FontSize="18"
                   Foreground="#FF8893AC"
                   Margin="0,16,0,0"
                   Opacity="0"/>
    </StackPanel>

    <!-- ============ CTA 按钮 ============ -->
    <Button x:Name="StartButton"
            Grid.Row="1"
            Content="开始上课  →"
            FontSize="22"
            Padding="48,16"
            Margin="0,0,140,80"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#FFE94560"
            Foreground="White"
            CornerRadius="10"
            BorderThickness="0"
            Opacity="0"/>
</Grid>
