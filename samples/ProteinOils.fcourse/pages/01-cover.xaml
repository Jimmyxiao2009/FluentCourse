<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF1A1A2E">

    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 装饰线条 -->
    <Border Width="120" Height="3" Background="#FFE94560"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Margin="0,-160,0,0" Opacity="0"/>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
        <TextBlock x:Name="TitleLine1"
                   Text="7.4.2"
                   FontSize="36"
                   Foreground="#FFE94560"
                   FontWeight="Light"
                   TextAlignment="Center"
                   Opacity="0"/>
        <TextBlock x:Name="TitleLine2"
                   Text="蛋白质  油脂"
                   FontSize="80"
                   FontWeight="Bold"
                   Foreground="#FFFFFFFF"
                   TextAlignment="Center"
                   Opacity="0"/>
        <TextBlock x:Name="SubtitleBlock"
                   Text="人教版高中化学必修第二册"
                   FontSize="24"
                   Foreground="#FF8888AA"
                   TextAlignment="Center"
                   Margin="0,24,0,0"
                   Opacity="0"/>
    </StackPanel>

    <Button x:Name="StartButton"
            Grid.Row="1"
            Content="开始上课 →"
            FontSize="22"
            Padding="40,14"
            Margin="0,0,60,50"
            HorizontalAlignment="Right"
            Background="#FFE94560"
            Foreground="White"
            CornerRadius="10"
            BorderThickness="0"/>
</Grid>
