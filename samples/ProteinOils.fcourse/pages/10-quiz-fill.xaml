<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fc="using:FluentCourse.Runtime.Controls"
      Background="#FF1A1A2E"
      Padding="100,80,100,80">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="课堂总结 — 填空题"
               FontSize="42" FontWeight="SemiBold" Foreground="White"
               Margin="0,0,0,30"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24">

            <fc:QuizControl x:Name="FillQuiz1" Mode="FillInBlank" AllowRetry="True"
                            ScoreStrategy="PartialCredit"
                            Question="1. 蛋白质是由 C、H、O、( ① ) 四种基本元素组成的天然有机( ② )化合物。其基本单元是( ③ )。">
                <fc:QuizControl.Blanks>
                    <fc:QuizBlank Pattern="(?i)N|氮" CaseSensitive="false"
                                  Explanation="蛋白质的组成元素为 C/H/O/N 四种，多数还含 S，少数含 P、Fe 等。N 是蛋白质区别于糖类和油脂的标志元素。"/>
                    <fc:QuizBlank Pattern="(?i)高分子|高[分份]子" CaseSensitive="false"
                                  Explanation="蛋白质、淀粉、纤维素都是天然有机高分子化合物。"/>
                    <fc:QuizBlank Pattern="(?i)氨基酸" CaseSensitive="false"
                                  Explanation="氨基酸是蛋白质的基本结构单元，自然界有 20 种 α-氨基酸。"/>
                </fc:QuizControl.Blanks>
            </fc:QuizControl>

            <fc:QuizControl x:Name="FillQuiz2" Mode="FillInBlank" AllowRetry="True"
                            ScoreStrategy="PartialCredit"
                            Question="2. 油脂在碱性条件下水解称为( ① )反应，产物为( ② )和甘油。液态植物油通过催化加氢可转化为固态脂肪，该过程称为油脂的( ③ )。">
                <fc:QuizControl.Blanks>
                    <fc:QuizBlank Pattern="(?i)皂化" CaseSensitive="false"
                                  Explanation="碱性水解 = 皂化反应。酸性水解不称皂化，这是考试中的常见区别点。"/>
                    <fc:QuizBlank Pattern="(?i)高级脂肪酸钠|脂肪酸钠|肥皂" CaseSensitive="false"
                                  Explanation="高级脂肪酸钠是肥皂的主要成分。若填"脂肪酸盐"也给分。"/>
                    <fc:QuizBlank Pattern="(?i)氢化" CaseSensitive="false"
                                  Explanation="油脂的氢化（硬化）是将液态油变为固态人造奶油/起酥油的重要工业过程。"/>
                </fc:QuizControl.Blanks>
            </fc:QuizControl>

        </StackPanel>
    </ScrollViewer>
</Grid>
