<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============ 装饰：右侧大尺寸结构式水印 ============ -->
    <Image Source="ms-fcourse:///assets/image14.jpeg"
           Stretch="Uniform"
           HorizontalAlignment="Right"
           VerticalAlignment="Center"
           Opacity="0.08"
           Width="720"
           Margin="0,0,80,0"/>

    <!-- ============ 左侧装饰条 ============ -->
    <Rectangle Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Fill="#FF00B4D8" Opacity="0.9"/>

    <!-- ============ 主标题块 ============ -->
    <StackPanel Grid.Row="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Margin="140,0,0,0"
                Spacing="16">

        <TextBlock Text="CHAPTER  2"
                   FontSize="32" FontWeight="Light"
                   Foreground="#FF00B4D8"
                   CharacterSpacing="200"/>

        <TextBlock Text="油  脂"
                   FontSize="160"
                   FontWeight="SemiBold"
                   Foreground="#FFF5F7FB"/>

        <Rectangle Width="120" Height="3"
                   Fill="#FF252D48"
                   Margin="0,16,0,0"/>

        <TextBlock Text="高级脂肪酸甘油酯"
                   FontSize="32" FontWeight="SemiBold"
                   Foreground="#FF00B4D8"/>

        <TextBlock Text="油（液态，不饱和）  ·  脂肪（固态，饱和）"
                   FontSize="20"
                   Foreground="#FFC7CEDD"
                   Margin="0,8,0,0"/>
    </StackPanel>

    <!-- ============ 页码 ============ -->
    <TextBlock Grid.Row="1"
               Text="6 / 11"
               FontSize="16"
               Foreground="#FF8893AC"
               HorizontalAlignment="Right"
               Margin="0,0,100,72"/>
</Grid>
