<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fc="using:FluentCourse.Runtime.Controls"
      Background="#FF1A1A2E"
      Padding="100">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="二、蛋白质的化学性质"
               FontSize="48" FontWeight="SemiBold" Foreground="White"
               Margin="0,0,0,30"/>

    <fc:StepRevealControl x:Name="PropReveal" Grid.Row="1">
        <Border BorderThickness="1" CornerRadius="10"
                BorderBrush="#FF2A2A4A" Padding="28,24" Margin="0,0,0,16"
                Background="#FF16162E">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Background="#FFE94560" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="1" FontSize="16" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="水解反应" FontSize="32" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="22" Foreground="#FFCCCCCC" LineHeight="34" Margin="0,8,0,0"
                           Text="蛋白质 → 多肽 → 氨基酸"/>
                <TextBlock FontSize="18" Foreground="#FF8888AA" Text="酸、碱或酶的催化下水解逐步进行，最终产物为多种氨基酸。"/>
            </StackPanel>
        </Border>

        <Border BorderThickness="1" CornerRadius="10"
                BorderBrush="#FF2A2A4A" Padding="28,24" Margin="0,0,0,16"
                Background="#FF16162E">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Background="#FF0F3460" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="2" FontSize="16" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="变性（不可逆）" FontSize="32" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="22" Foreground="#FFCCCCCC" LineHeight="34" Margin="0,8,0,0">
                    蛋白质在
                    <Run Text="加热" Foreground="#FFE94560" FontWeight="SemiBold"/>、
                    <Run Text="紫外线" Foreground="#FFE94560" FontWeight="SemiBold"/>、
                    <Run Text="重金属盐" Foreground="#FFE94560" FontWeight="SemiBold"/>、
                    <Run Text="强酸/强碱" Foreground="#FFE94560" FontWeight="SemiBold"/>、
                    <Run Text="乙醇" Foreground="#FFE94560" FontWeight="SemiBold"/>
                    等条件下，构象被破坏，溶解度下降，失去生理活性。
                </TextBlock>
                <Border Background="#1A0F3460" Padding="16,12" CornerRadius="6" Margin="0,8,0,0">
                    <TextBlock FontSize="18" Foreground="#FF9090AA" TextWrapping="Wrap"
                               Text="盐析（加Na₂SO₄等轻金属盐）是可逆的；变性是不可逆的。医院用酒精消毒、重金属中毒急救都是利用变性原理。"/>
                </Border>
            </StackPanel>
        </Border>

        <Border BorderThickness="1" CornerRadius="10"
                BorderBrush="#FF2A2A4A" Padding="28,24" Margin="0,0,0,16"
                Background="#FF16162E">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Background="#FF533A83" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="3" FontSize="16" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="鉴别方法" FontSize="32" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="22" Foreground="#FFCCCCCC" LineHeight="34" Margin="0,8,0,0">
                    <Run Text="显色反应："/>含<Run Text="苯环" Foreground="#FF00D2FF"/>的蛋白质遇浓硝酸呈<Run Text="黄色" Foreground="#FFE94560"/>。
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="22" Foreground="#FFCCCCCC" LineHeight="34">
                    <Run Text="燃烧法："/>蛋白质灼烧时有<Run Text="烧焦羽毛的气味" Foreground="#FFE94560" FontWeight="SemiBold"/>。
                    可用于鉴别<Run Text="丝" Foreground="#FF00D2FF"/>、<Run Text="毛" Foreground="#FF00D2FF"/>织品与化纤。
                </TextBlock>
            </StackPanel>
        </Border>
    </fc:StepRevealControl>

    <Border Grid.Row="2" BorderBrush="#FF2A2A4A" BorderThickness="0,1,0,0" Padding="0,16,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <TextBlock Text="点击按钮逐步显示" Foreground="#FF8888AA" FontSize="16" VerticalAlignment="Center"/>
            <Button x:Name="NextPoint"
                    Content="下一步 ▶"
                    FontSize="18" Padding="24,10"
                    Background="#FFE94560" Foreground="White"
                    CornerRadius="6" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Grid>
