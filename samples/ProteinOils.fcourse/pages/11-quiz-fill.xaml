<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fc="using:FluentCourse.Runtime.Controls"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- =================== HeaderStrip =================== -->
    <Grid Grid.Row="0" Margin="100,72,100,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#338B5CF6"
                BorderBrush="#FF8B5CF6" BorderThickness="1"
                CornerRadius="4"
                Padding="14,6">
            <TextBlock Text="练习"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#FF8B5CF6"/>
        </Border>

        <TextBlock Grid.Column="1"
                   Text="随堂检测  ·  填空题"
                   FontSize="40" FontWeight="SemiBold"
                   Foreground="#FFF5F7FB"
                   VerticalAlignment="Center"
                   Margin="20,0,0,0"/>

        <TextBlock Grid.Column="2"
                   Text="11 / 11"
                   FontSize="16"
                   Foreground="#FF8893AC"
                   VerticalAlignment="Center"/>
    </Grid>

    <Rectangle Grid.Row="0" Height="1" Margin="100,16,100,0"
               VerticalAlignment="Bottom"
               Fill="#FF252D48"/>

    <!-- =================== Body =================== -->
    <ScrollViewer Grid.Row="1" Margin="100,40,100,60"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="1200" HorizontalAlignment="Center">

            <fc:QuizControl x:Name="FillQuiz1" Mode="FillInBlank" AllowRetry="True"
                            ScoreStrategy="PartialCredit"
                            Question="1. 蛋白质是由 C、H、O、( ① ) 四种基本元素组成的天然有机( ② )化合物。其基本单元是( ③ )。">
                <fc:QuizControl.Blanks>
                    <fc:QuizBlank Pattern="(?i)N|氮" CaseSensitive="false"
                                  Explanation="蛋白质的组成元素为 C/H/O/N 四种，多数还含 S，少数含 P、Fe 等。N 是蛋白质区别于糖类和油脂的标志元素。"/>
                    <fc:QuizBlank Pattern="(?i)高分子|高[分份]子" CaseSensitive="false"
                                  Explanation="蛋白质、淀粉、纤维素都是天然有机高分子化合物。"/>
                    <fc:QuizBlank Pattern="(?i)氨基酸" CaseSensitive="false"
                                  Explanation="氨基酸是蛋白质的基本结构单元，自然界有 20 种 α-氨基酸。"/>
                </fc:QuizControl.Blanks>
            </fc:QuizControl>

            <fc:QuizControl x:Name="FillQuiz2" Mode="FillInBlank" AllowRetry="True"
                            ScoreStrategy="PartialCredit"
                            Question="2. 油脂在碱性条件下水解称为( ① )反应，产物为( ② )和甘油。液态植物油通过催化加氢可转化为固态脂肪，该过程称为油脂的( ③ )。">
                <fc:QuizControl.Blanks>
                    <fc:QuizBlank Pattern="(?i)皂化" CaseSensitive="false"
                                  Explanation="碱性水解 = 皂化反应。酸性水解不称皂化，这是考试中的常见区别点。"/>
                    <fc:QuizBlank Pattern="(?i)高级脂肪酸钠|脂肪酸钠|肥皂" CaseSensitive="false"
                                  Explanation="高级脂肪酸钠是肥皂的主要成分。若填「脂肪酸盐」也给分。"/>
                    <fc:QuizBlank Pattern="(?i)氢化" CaseSensitive="false"
                                  Explanation="油脂的氢化（硬化）是将液态油变为固态人造奶油/起酥油的重要工业过程。"/>
                </fc:QuizControl.Blanks>
            </fc:QuizControl>

        </StackPanel>
    </ScrollViewer>
</Grid>
