<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- =================== HeaderStrip =================== -->
    <Grid Grid.Row="0" Margin="100,72,100,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#3300B4D8"
                BorderBrush="#FF00B4D8" BorderThickness="1"
                CornerRadius="4"
                Padding="14,6">
            <TextBlock Text="油脂"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#FF00B4D8"/>
        </Border>

        <TextBlock Grid.Column="1"
                   Text="一、油脂的组成与结构"
                   FontSize="40" FontWeight="SemiBold"
                   Foreground="#FFF5F7FB"
                   VerticalAlignment="Center"
                   Margin="20,0,0,0"/>

        <TextBlock Grid.Column="2"
                   Text="7 / 11"
                   FontSize="16"
                   Foreground="#FF8893AC"
                   VerticalAlignment="Center"/>
    </Grid>

    <Rectangle Grid.Row="0" Height="1" Margin="100,16,100,0"
               VerticalAlignment="Bottom"
               Fill="#FF252D48"/>

    <!-- =================== Body =================== -->
    <Grid Grid.Row="1" Margin="100,40,100,60">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="600"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="2*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <!-- ====== Left: 4 cards stacked ====== -->
        <StackPanel Grid.Column="0" Spacing="14">

            <!-- Card 1: 分类 -->
            <Border BorderThickness="1" CornerRadius="10"
                    BorderBrush="#FF252D48"
                    Background="#FF161D33"
                    Padding="24,20">
                <StackPanel Spacing="8">
                    <TextBlock Text="分类"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="#FF00B4D8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="油" FontSize="22" FontWeight="SemiBold" Foreground="#FF00B4D8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FFC7CEDD" LineHeight="28">
                                常温下 <Run Text="液态" Foreground="#FF00B4D8" FontWeight="SemiBold"/>，
                                含较多不饱和脂肪酸（植物油）。
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="24,0,0,0">
                            <TextBlock Text="脂肪" FontSize="22" FontWeight="SemiBold" Foreground="#FF00B4D8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FFC7CEDD" LineHeight="28">
                                常温下 <Run Text="固态" Foreground="#FF00B4D8" FontWeight="SemiBold"/>，
                                含较多饱和脂肪酸（动物脂肪）。
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: 物理性质 -->
            <Border BorderThickness="1" CornerRadius="10"
                    BorderBrush="#FF252D48"
                    Background="#FF161D33"
                    Padding="24,20">
                <StackPanel Spacing="8">
                    <TextBlock Text="物理性质"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="#FF00B4D8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FFC7CEDD" LineHeight="28">
                        · 密度比水 <Run Text="小" Foreground="#FF00B4D8" FontWeight="SemiBold"/>，浮于水面
                        <LineBreak/>
                        · 黏度较大
                        <LineBreak/>
                        · <Run Text="不" Foreground="#FF00B4D8" FontWeight="SemiBold"/>溶于水，
                          <Run Text="易" Foreground="#FF00B4D8" FontWeight="SemiBold"/>溶于有机溶剂
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 3: 组成元素 -->
            <Border BorderThickness="1" CornerRadius="10"
                    BorderBrush="#FF252D48"
                    Background="#FF161D33"
                    Padding="24,20">
                <StackPanel Spacing="8">
                    <TextBlock Text="组成元素"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="#FF00B4D8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FFC7CEDD" LineHeight="28">
                        仅含 <Run Text="C、H、O" Foreground="#FF00B4D8" FontWeight="SemiBold"/> 三种元素
                        （区别于蛋白质——油脂中无氮）。
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 4: 常见脂肪酸 -->
            <Border BorderThickness="1" CornerRadius="10"
                    BorderBrush="#FF252D48"
                    Background="#FF161D33"
                    Padding="24,20">
                <StackPanel Spacing="6">
                    <TextBlock Text="常见高级脂肪酸"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="#FF00B4D8"/>
                    <TextBlock FontSize="16" Foreground="#FF8893AC" Text="饱和脂肪酸" Margin="0,4,0,0"/>
                    <TextBlock FontSize="17" Foreground="#FFC7CEDD" FontFamily="Consolas, Cambria Math"
                               Text="软脂酸（棕榈酸）   C₁₅H₃₁COOH"/>
                    <TextBlock FontSize="17" Foreground="#FFC7CEDD" FontFamily="Consolas, Cambria Math"
                               Text="硬脂酸             C₁₇H₃₅COOH"/>
                    <TextBlock FontSize="16" Foreground="#FF8893AC" Text="不饱和脂肪酸" Margin="0,8,0,0"/>
                    <TextBlock FontSize="17" Foreground="#FFC7CEDD" FontFamily="Consolas, Cambria Math"
                               Text="油酸               C₁₇H₃₃COOH"/>
                    <TextBlock FontSize="17" Foreground="#FFC7CEDD" FontFamily="Consolas, Cambria Math"
                               Text="亚油酸             C₁₇H₃₁COOH"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ====== Right: triglyceride structure ====== -->
        <Border Grid.Column="2"
                BorderThickness="1" CornerRadius="10"
                BorderBrush="#FF252D48"
                Background="#FF161D33"
                Padding="28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="油脂的结构通式"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="#FF00B4D8"
                           Margin="0,0,0,16"/>

                <Border Grid.Row="1"
                        BorderBrush="#FF3B4566" BorderThickness="1"
                        CornerRadius="6"
                        Background="#FF1E2747"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Image Source="ms-fcourse:///assets/image14.jpeg"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="18" Foreground="#FFC7CEDD" LineHeight="28">
                        <Run Text="甘油酯" Foreground="#FF00B4D8" FontWeight="SemiBold"/>
                        ：甘油（丙三醇）与 <Run Text="3 分子" Foreground="#FF00B4D8" FontWeight="SemiBold"/>
                        高级脂肪酸酯化而成。
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="18" Foreground="#FFC7CEDD" LineHeight="28">
                        R / R' / R" 可以相同也可不同，<Run Text="饱和度" Foreground="#FF00B4D8" FontWeight="SemiBold"/>
                        决定油脂的形态。
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Grid>
