<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- =================== HeaderStrip =================== -->
    <Grid Grid.Row="0" Margin="100,72,100,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#33E94560"
                BorderBrush="#FFE94560" BorderThickness="1"
                CornerRadius="4"
                Padding="14,6">
            <TextBlock Text="蛋白质"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#FFE94560"/>
        </Border>

        <TextBlock Grid.Column="1"
                   Text="一、蛋白质的组成"
                   FontSize="40" FontWeight="SemiBold"
                   Foreground="#FFF5F7FB"
                   VerticalAlignment="Center"
                   Margin="20,0,0,0"/>

        <TextBlock Grid.Column="2"
                   Text="3 / 11"
                   FontSize="16"
                   Foreground="#FF8893AC"
                   VerticalAlignment="Center"/>
    </Grid>

    <Rectangle Grid.Row="0" Height="1" Margin="100,16,100,0"
               VerticalAlignment="Bottom"
               Fill="#FF252D48"/>

    <!-- =================== Body =================== -->
    <Grid Grid.Row="1" Margin="100,40,100,60">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="600"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="2*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- ====== Left: 3 cards stacked ====== -->
        <StackPanel Grid.Column="0" Spacing="16">

            <!-- Card 1: 存在与组成 -->
            <Border BorderThickness="1" CornerRadius="10"
                    BorderBrush="#FF252D48"
                    Background="#FF161D33"
                    Padding="28,24">
                <StackPanel Spacing="10">
                    <TextBlock Text="存在与组成"
                               FontSize="26" FontWeight="SemiBold"
                               Foreground="#FFE94560"/>
                    <TextBlock TextWrapping="Wrap" FontSize="20" Foreground="#FFC7CEDD" LineHeight="32">
                        <Run Text="蛋白质广泛存在于各种生物组织细胞中，是" />
                        <Run Text="天然有机高分子化合物" FontWeight="SemiBold" Foreground="#FFE94560"/>
                        <Run Text="。" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="20" Foreground="#FFC7CEDD" LineHeight="32">
                        <Run Text="组成元素：" />
                        <Run Text="C、H、O、N" Foreground="#FFE94560" FontWeight="SemiBold"/>
                        <Run Text="，多数含 S，少量含 P、Fe 等。" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 2: 基本单元 — 氨基酸 -->
            <Border BorderThickness="1" CornerRadius="10"
                    BorderBrush="#FF252D48"
                    Background="#FF161D33"
                    Padding="28,24">
                <StackPanel Spacing="10">
                    <TextBlock Text="基本单元  —  氨基酸"
                               FontSize="26" FontWeight="SemiBold"
                               Foreground="#FFE94560"/>
                    <TextBlock TextWrapping="Wrap" FontSize="20" Foreground="#FFC7CEDD" LineHeight="32">
                        <Run Text="蛋白质在" />
                        <Run Text="酸、碱或酶" Foreground="#FFE94560" FontWeight="SemiBold"/>
                        <Run Text="催化下水解，最终生成" />
                        <Run Text="氨基酸" Foreground="#FFE94560" FontWeight="SemiBold"/>
                        <Run Text="。" />
                    </TextBlock>
                    <Border BorderThickness="1" CornerRadius="6"
                            BorderBrush="#FF3B4566"
                            Background="#FF1E2747"
                            Padding="20,14"
                            Margin="0,8,0,0">
                        <TextBlock Text="H₂N — CαH(R) — COOH"
                                   FontSize="22"
                                   FontFamily="Consolas, Cambria Math"
                                   Foreground="#FFF5F7FB"
                                   TextAlignment="Center"/>
                    </Border>
                    <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FF8893AC" LineHeight="28" Margin="0,4,0,0">
                        α-氨基酸：氨基（—NH₂）与羧基（—COOH）连接在同一个碳原子上。R 基决定氨基酸种类。
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 3: 物理性质 -->
            <Border BorderThickness="1" CornerRadius="10"
                    BorderBrush="#FF252D48"
                    Background="#FF161D33"
                    Padding="28,24">
                <StackPanel Spacing="10">
                    <TextBlock Text="物理性质"
                               FontSize="26" FontWeight="SemiBold"
                               Foreground="#FFE94560"/>
                    <TextBlock TextWrapping="Wrap" FontSize="20" Foreground="#FFC7CEDD" LineHeight="32">
                        <Run Text="有些蛋白质" />
                        <Run Text="易" Foreground="#FFE94560" FontWeight="SemiBold"/>
                        <Run Text="溶于水（鸡蛋白），有些" />
                        <Run Text="难" Foreground="#FFE94560" FontWeight="SemiBold"/>
                        <Run Text="溶于水（丝、毛）。" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="20" Foreground="#FFC7CEDD" LineHeight="32">
                        分子直径达 10⁻⁹~10⁻⁷ m，溶液具有<Run Text="胶体性质" Foreground="#FFE94560" FontWeight="SemiBold"/>。
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ====== Right: featured amino acid structure ====== -->
        <Border Grid.Column="2"
                BorderThickness="1" CornerRadius="10"
                BorderBrush="#FF252D48"
                Background="#FF161D33"
                Padding="28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="氨基酸结构示例"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="#FFE94560"
                           Margin="0,0,0,16"/>

                <Border Grid.Row="1"
                        BorderBrush="#FF3B4566" BorderThickness="1"
                        CornerRadius="6"
                        Background="#FF1E2747"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Image Source="ms-fcourse:///assets/image5.jpeg"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Row="2"
                           TextWrapping="Wrap"
                           FontSize="18" Foreground="#FF8893AC" LineHeight="28"
                           Text="苯丙氨酸：含苯环的 α-氨基酸。蛋白质中的 R 基决定其空间结构与功能。" />

            </Grid>
        </Border>

    </Grid>
</Grid>
