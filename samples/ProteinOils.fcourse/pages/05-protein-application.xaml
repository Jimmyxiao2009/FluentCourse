<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF1A1A2E"
      Padding="100,60,100,60">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="三、蛋白质的应用"
               FontSize="48" FontWeight="SemiBold" Foreground="White"
               Margin="0,0,0,40"/>

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 食品 -->
        <Border BorderThickness="1" CornerRadius="10" Margin="0,0,20,0"
                BorderBrush="#FF2A2A4A" Padding="28,24"
                Background="#FF16162E">
            <StackPanel Spacing="12">
                <TextBlock Text="🍽" FontSize="36"/>
                <TextBlock Text="食品工业" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FFAAAAAA" LineHeight="26">
                    牛奶、鸡蛋、大豆是优质蛋白来源。蛋白质可加工为食品添加剂、营养强化剂。
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 纺织 -->
        <Border BorderThickness="1" CornerRadius="10" Margin="0,0,20,0"
                BorderBrush="#FF2A2A4A" Padding="28,24"
                Background="#FF16162E">
            <StackPanel Spacing="12">
                <TextBlock Text="🧵" FontSize="36"/>
                <TextBlock Text="纺织材料" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FFAAAAAA" LineHeight="26">
                    蚕丝织成丝绸制高档服装；皮革（胶原蛋白鞣制）制成鞋包。羊毛是重要的天然蛋白纤维。
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 医药 -->
        <Border BorderThickness="1" CornerRadius="10"
                BorderBrush="#FF2A2A4A" Padding="28,24"
                Background="#FF16162E">
            <StackPanel Spacing="12">
                <TextBlock Text="💊" FontSize="36"/>
                <TextBlock Text="医药领域" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock TextWrapping="Wrap" FontSize="18" Foreground="#FFAAAAAA" LineHeight="26">
                    阿胶（驴皮提取）是传统中药；医用胶囊、手术缝合线、酶感光胶片、胰岛素等均利用蛋白质。
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
