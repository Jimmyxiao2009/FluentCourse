<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF1A1A2E"
      Padding="100">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="学习目标"
               FontSize="52" FontWeight="SemiBold"
               Foreground="White" Margin="0,0,0,40"/>

    <StackPanel Grid.Row="1" Spacing="20" VerticalAlignment="Center">
        <Border BorderBrush="#FFE94560" BorderThickness="2,0,0,0"
                Padding="24,16" CornerRadius="6"
                Background="#1AE94560">
            <TextBlock TextWrapping="Wrap" FontSize="26" Foreground="#FFE0E0E0">
                <Run Text="了解蛋白质、油脂的组成，掌握蛋白质、油脂的主要性质。" FontWeight="SemiBold" Foreground="White"/>
                <LineBreak/>
                <Run Text="培养「宏观辨识与微观探析」素养。"/>
            </TextBlock>
        </Border>

        <Border BorderBrush="#FF0F3460" BorderThickness="2,0,0,0"
                Padding="24,16" CornerRadius="6"
                Background="#1A0F3460">
            <TextBlock TextWrapping="Wrap" FontSize="26" Foreground="#FFE0E0E0">
                <Run Text="了解蛋白质、油脂在日常生活中的应用，" FontWeight="SemiBold" Foreground="White"/>
                <Run Text="提高科学探究与创新能力，培养社会责任感。"/>
            </TextBlock>
        </Border>
    </StackPanel>

    <Button x:Name="GoProteinBtn"
            Grid.Row="2"
            Content="进入蛋白质 →"
            FontSize="20" Padding="32,12"
            HorizontalAlignment="Right"
            Background="#FFE94560" Foreground="White"
            CornerRadius="8" BorderThickness="0"/>
</Grid>
