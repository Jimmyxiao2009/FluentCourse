<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF0E1424">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- =================== HeaderStrip =================== -->
    <Grid Grid.Row="0" Margin="100,72,100,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Section badge -->
        <Border Grid.Column="0"
                Background="#338B5CF6"
                BorderBrush="#FF8B5CF6" BorderThickness="1"
                CornerRadius="4"
                Padding="14,6">
            <TextBlock Text="开场"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#FF8B5CF6"/>
        </Border>

        <!-- Page title -->
        <TextBlock Grid.Column="1"
                   Text="学习目标"
                   FontSize="40" FontWeight="SemiBold"
                   Foreground="#FFF5F7FB"
                   VerticalAlignment="Center"
                   Margin="20,0,0,0"/>

        <!-- Page index -->
        <TextBlock Grid.Column="2"
                   Text="2 / 11"
                   FontSize="16"
                   Foreground="#FF8893AC"
                   VerticalAlignment="Center"/>
    </Grid>

    <!-- Thin separator under header -->
    <Rectangle Grid.Row="0" Height="1" Margin="100,16,100,0"
               VerticalAlignment="Bottom"
               Fill="#FF252D48"/>

    <!-- =================== Body =================== -->
    <Grid Grid.Row="1" Margin="100,40,100,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="24" VerticalAlignment="Center" MaxWidth="1400" HorizontalAlignment="Center">

            <!-- 目标 1 -->
            <Border BorderThickness="1" CornerRadius="10"
                    BorderBrush="#FF252D48"
                    Background="#FF161D33"
                    Padding="32,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#338B5CF6"
                            CornerRadius="8"
                            Width="56" Height="56"
                            VerticalAlignment="Top">
                        <TextBlock Text="1"
                                   FontSize="28" FontWeight="SemiBold"
                                   Foreground="#FF8B5CF6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="8">
                        <TextBlock Text="知识目标"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#FF8B5CF6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="24" Foreground="#FFF5F7FB" LineHeight="36">
                            <Run Text="了解蛋白质、油脂的" />
                            <Run Text="组成与主要性质" FontWeight="SemiBold" Foreground="#FF8B5CF6"/>
                            <Run Text="，能识别氨基酸与甘油酯的结构特征。" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 目标 2 -->
            <Border BorderThickness="1" CornerRadius="10"
                    BorderBrush="#FF252D48"
                    Background="#FF161D33"
                    Padding="32,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#338B5CF6"
                            CornerRadius="8"
                            Width="56" Height="56"
                            VerticalAlignment="Top">
                        <TextBlock Text="2"
                                   FontSize="28" FontWeight="SemiBold"
                                   Foreground="#FF8B5CF6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="8">
                        <TextBlock Text="素养目标"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#FF8B5CF6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="24" Foreground="#FFF5F7FB" LineHeight="36">
                            <Run Text="认识蛋白质与油脂在" />
                            <Run Text="日常生活与科技" FontWeight="SemiBold" Foreground="#FF8B5CF6"/>
                            <Run Text="中的应用，培养" />
                            <Run Text="宏观辨识与微观探析" FontWeight="SemiBold" Foreground="#FF8B5CF6"/>
                            <Run Text="的核心化学素养。" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </Grid>

    <!-- =================== FooterStrip =================== -->
    <Border Grid.Row="2" Margin="100,0,100,72"
            BorderBrush="#FF252D48" BorderThickness="0,1,0,0"
            Padding="0,24,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <TextBlock Text="下一章：蛋白质"
                       Foreground="#FF8893AC" FontSize="16"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="GoProteinBtn"
                    Content="进入蛋白质  →"
                    FontSize="20" Padding="32,12"
                    Background="#FF8B5CF6"
                    Foreground="White"
                    CornerRadius="8"
                    BorderThickness="0"/>
        </StackPanel>
    </Border>
</Grid>
