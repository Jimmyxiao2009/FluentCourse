<?xml version="1.0" encoding="utf-8"?>
<!--
  蛋白质油脂课件 · 视觉令牌字典 v1
  真源：docs/design-system.md
  运行时：当前 XamlReader 不消费资源引用，页面需以字面量值同步。改令牌时请
  同时更新 docs/design-system.md 与所有 pages/*.xaml。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =================== 背景与表面 =================== -->
    <SolidColorBrush x:Key="BgStage"           Color="#FF0E1424"/>
    <SolidColorBrush x:Key="BgPage"            Color="#FF0E1424"/>
    <SolidColorBrush x:Key="BgElevated"        Color="#FF161D33"/>
    <SolidColorBrush x:Key="BgElevated2"       Color="#FF1E2747"/>

    <!-- =================== 边框 =================== -->
    <SolidColorBrush x:Key="BorderSubtle"      Color="#FF252D48"/>
    <SolidColorBrush x:Key="BorderStrong"      Color="#FF3B4566"/>

    <!-- =================== 文字 =================== -->
    <SolidColorBrush x:Key="TextPrimary"       Color="#FFF5F7FB"/>
    <SolidColorBrush x:Key="TextSecondary"     Color="#FFC7CEDD"/>
    <SolidColorBrush x:Key="TextMuted"         Color="#FF8893AC"/>

    <!-- =================== 主题强调色 =================== -->
    <SolidColorBrush x:Key="AccentProtein"     Color="#FFE94560"/>
    <SolidColorBrush x:Key="AccentProteinSoft" Color="#33E94560"/>
    <SolidColorBrush x:Key="AccentLipid"       Color="#FF00B4D8"/>
    <SolidColorBrush x:Key="AccentLipidSoft"   Color="#3300B4D8"/>
    <SolidColorBrush x:Key="AccentNeutral"     Color="#FF8B5CF6"/>
    <SolidColorBrush x:Key="AccentSuccess"     Color="#FF22C55E"/>
    <SolidColorBrush x:Key="AccentWarning"     Color="#FFF59E0B"/>

    <!-- =================== 字体 =================== -->
    <x:String x:Key="FontChem">Consolas, Cambria Math, monospace</x:String>

    <!-- =================== 间距（Double） =================== -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">16</x:Double>
    <x:Double x:Key="SpaceL">24</x:Double>
    <x:Double x:Key="SpaceXl">32</x:Double>
    <x:Double x:Key="SpaceXxl">48</x:Double>

    <!-- =================== 通用内边距 =================== -->
    <Thickness x:Key="PaddingContent">100,80,100,80</Thickness>
    <Thickness x:Key="PaddingCard">28,24</Thickness>
    <Thickness x:Key="PaddingCardSub">24,20</Thickness>
    <Thickness x:Key="PaddingFormula">20,14</Thickness>

    <!-- =================== 圆角 =================== -->
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">4</CornerRadius>

</ResourceDictionary>
