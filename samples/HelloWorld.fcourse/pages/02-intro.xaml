<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF1F1F1F">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <TextBlock Grid.Row="0"
               Text="什么是 FluentCourse"
               FontSize="56"
               FontWeight="SemiBold"
               Foreground="White"
               Margin="80,60,80,0"/>

    <!-- 内容区 -->
    <StackPanel Grid.Row="1" Spacing="24" Margin="80,40,80,0" VerticalAlignment="Top">
        <TextBlock x:Name="Point1"
                   FontSize="28"
                   Foreground="#FFE0E0E0"
                   Text="• 基于 WinUI 3 原生控件，不依赖 WebView2"/>
        <TextBlock x:Name="Point2"
                   FontSize="28"
                   Foreground="#FFE0E0E0"
                   Opacity="0.15"
                   Text="• 触发器+动作配置，无需写一行 C#"/>
        <TextBlock x:Name="Point3"
                   FontSize="28"
                   Foreground="#FFE0E0E0"
                   Opacity="0.15"
                   Text="• Storyboard 动画，60fps 平滑过渡"/>
    </StackPanel>

    <!-- 底部按钮区 -->
    <Border Grid.Row="2"
            BorderBrush="#33FFFFFF"
            BorderThickness="0,1,0,0"
            Padding="80,16">
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <TextBlock x:Name="StepHint"
                       Text="点击继续逐步显示"
                       Foreground="#88FFFFFF"
                       VerticalAlignment="Center"
                       FontSize="14"/>
            <Button x:Name="NextButton"
                    Content="继续 ▶"
                    FontSize="18"
                    Padding="28,10"
                    Background="#FF0078D4"
                    Foreground="White"
                    CornerRadius="6"/>
        </StackPanel>
    </Border>
</Grid>
