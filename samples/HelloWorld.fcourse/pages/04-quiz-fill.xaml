<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fc="using:FluentCourse.Runtime.Controls"
      Background="#FF1F1F1F"
      Padding="120">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Text="填空题"
               FontSize="56"
               FontWeight="SemiBold"
               Foreground="White"/>

    <fc:QuizControl x:Name="FillQuiz"
                    Grid.Row="1"
                    Margin="0,40,0,0"
                    Mode="FillInBlank"
                    ScoreStrategy="PartialCredit"
                    AllowRetry="True"
                    Question="请填写 Windows App SDK 简称和其 UI 层名称：">
        <fc:QuizControl.Blanks>
            <fc:QuizBlank Pattern="(?i)was" Explanation="Windows App SDK 缩写为 WAS，原称 Project Reunion。2021 年发布稳定版。" />
            <fc:QuizBlank Pattern="(?i)winui\s*3" Explanation="Windows App SDK 的 UI 层是 WinUI 3，不是 UWP 的 WinUI 2，也不是 .NET MAUI。" />
        </fc:QuizControl.Blanks>
    </fc:QuizControl>
</Grid>
