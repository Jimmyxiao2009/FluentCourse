<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentCourse.Designer.Views.PropertiesPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
            <StackPanel Spacing="2">
                <TextBlock x:Name="ElementLabel" Style="{StaticResource H2Text}"/>
                <TextBlock x:Name="ElementPath" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PropertyRoot" Spacing="4" Padding="8">
                <TextBlock x:Name="EmptyHint" Text="无选中元素"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           FontSize="13" Margin="0,16,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
