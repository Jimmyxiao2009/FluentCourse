<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentCourse.Designer.Views.PropertiesPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="2">
            <TextBlock x:Name="ElementLabel" FontSize="12" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

            <ItemsControl x:Name="PropertyList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBox Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Padding="6,4"
                                     BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyHint" Text="无选中元素"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="13" Margin="0,16,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
