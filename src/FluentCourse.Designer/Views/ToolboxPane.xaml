<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentCourse.Designer.Views.ToolboxPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">
            <TextBlock Text="工具箱" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <ItemsControl x:Name="ToolboxList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemAccentColorBrush}" Margin="0,8,0,4"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ToolboxButton}"
                                                Click="OnItemClicked"
                                                ToolTipService.ToolTip="{Binding Description}">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
