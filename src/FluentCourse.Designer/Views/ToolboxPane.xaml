<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentCourse.Designer.Views.ToolboxPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:FluentCourse.Designer.Services">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
            <StackPanel Spacing="2">
                <TextBlock Text="工具箱" Style="{StaticResource H2Text}"/>
                <TextBlock Text="拖拽到画布插入" Style="{StaticResource CaptionText}"/>
            </StackPanel>
        </Border>

        <!-- 搜索框 -->
        <Border Grid.Row="1" Padding="8,6,8,2" BorderBrush="{StaticResource StrokeSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="搜索控件..."
                         FontSize="12" Padding="6,4"
                         TextChanged="OnSearchTextChanged"/>
                <TextBlock Grid.Column="1" Text="🔍" FontSize="12"
                           VerticalAlignment="Center" Margin="6,0,4,0"
                           Foreground="{StaticResource TextTertiaryBrush}"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Padding="8" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ToolboxList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="2,0,0,6" CharacterSpacing="60"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ToolboxCard}"
                                                Click="OnItemClicked"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="{Binding Description}"
                                                CanDrag="True"
                                                DragStarting="OnDragStarting"
                                                DropCompleted="OnDragCompleted"
                                                RightTapped="OnItemRightTapped">
                                            <Grid Padding="10,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                               Style="{StaticResource BodyText}"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="10"
                                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="≡"
                                                           FontSize="14"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource PanelHeader}" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="💡" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                           Text="点击插入到页面;拖拽到画布具体位置"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
