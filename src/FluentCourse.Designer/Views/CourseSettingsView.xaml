<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentCourse.Designer.Views.CourseSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">
            <TextBlock Text="课程设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBlock Text="标题" Style="{StaticResource PropertyLabel}"/>
            <TextBox x:Name="TitleBox" Header="标题" TextChanged="OnFieldChanged"/>

            <TextBlock Text="作者" Style="{StaticResource PropertyLabel}"/>
            <TextBox x:Name="AuthorBox" Header="作者" TextChanged="OnFieldChanged"/>

            <TextBlock Text="语言" Style="{StaticResource PropertyLabel}"/>
            <ComboBox x:Name="LanguageBox" Header="语言" SelectionChanged="OnFieldChanged">
                <ComboBoxItem Content="简体中文 (zh-CN)" Tag="zh-CN"/>
                <ComboBoxItem Content="English (en-US)" Tag="en-US"/>
            </ComboBox>

            <TextBlock Text="舞台" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,4"/>

            <TextBlock Text="设计宽度" Style="{StaticResource PropertyLabel}"/>
            <NumberBox x:Name="DesignWidthBox" Value="1920" Minimum="640" Maximum="7680"
                       ValueChanged="OnFieldChanged"/>

            <TextBlock Text="设计高度" Style="{StaticResource PropertyLabel}"/>
            <NumberBox x:Name="DesignHeightBox" Value="1080" Minimum="480" Maximum="4320"
                       ValueChanged="OnFieldChanged"/>

            <TextBlock Text="缩放模式" Style="{StaticResource PropertyLabel}"/>
            <ComboBox x:Name="ScaleModeBox" SelectionChanged="OnFieldChanged">
                <ComboBoxItem Content="均匀缩放" Tag="Uniform"/>
                <ComboBoxItem Content="拉伸填充" Tag="Stretch"/>
                <ComboBoxItem Content="均匀裁剪" Tag="UniformToFill"/>
                <ComboBoxItem Content="无缩放" Tag="None"/>
            </ComboBox>

            <TextBlock Text="背景色" Style="{StaticResource PropertyLabel}"/>
            <TextBox x:Name="BgBox" PlaceholderText="#FF000000" TextChanged="OnFieldChanged"/>

            <TextBlock Text="主题" Style="{StaticResource PropertyLabel}"/>
            <ComboBox x:Name="ThemeBox" SelectionChanged="OnFieldChanged">
                <ComboBoxItem Content="跟随系统" Tag="System"/>
                <ComboBoxItem Content="浅色" Tag="Light"/>
                <ComboBoxItem Content="深色" Tag="Dark"/>
            </ComboBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
