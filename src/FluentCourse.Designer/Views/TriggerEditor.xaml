<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentCourse.Designer.Views.TriggerEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,4">
            <TextBlock Text="触发器编辑" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="AddBtn" Content="+" Width="28" Height="28" FontSize="16"
                    ToolTipService.ToolTip="添加触发器" Click="OnAddTrigger"/>
            <Button x:Name="DelBtn" Content="×" Width="28" Height="28" FontSize="14"
                    ToolTipService.ToolTip="删除选中" Click="OnDeleteTrigger"
                    Foreground="#FFFF6B6B"/>
        </StackPanel>

        <!-- Trigger list -->
        <ListView x:Name="TriggerList" Grid.Row="1" Margin="8,0"
                  SelectionMode="Single" SelectionChanged="OnTriggerSelected">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Summary}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Padding="4,6"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Edit form (scrollable) -->
        <ScrollViewer x:Name="EditForm" Grid.Row="2" Margin="8" VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ID" Style="{StaticResource PropertyLabel}"/>
                        <TextBox x:Name="TIdBox" TextChanged="OnFieldChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="页面" Style="{StaticResource PropertyLabel}"/>
                        <ComboBox x:Name="TPageBox" SelectionChanged="OnFieldChanged"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="事件" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,4"/>

                <TextBlock Text="事件类型" Style="{StaticResource PropertyLabel}"/>
                <ComboBox x:Name="TEventTypeBox" SelectionChanged="OnFieldChanged"/>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="目标元素 (x:Name)" Style="{StaticResource PropertyLabel}"/>
                        <TextBox x:Name="TTargetBox" TextChanged="OnFieldChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="按键 (Key事件)" Style="{StaticResource PropertyLabel}"/>
                        <TextBox x:Name="TKeyBox" TextChanged="OnFieldChanged"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="点击次数" Style="{StaticResource PropertyLabel}"/>
                        <TextBox x:Name="TTapCountBox" TextChanged="OnFieldChanged" PlaceholderText="1/2/3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="去抖 (ms)" Style="{StaticResource PropertyLabel}"/>
                        <TextBox x:Name="TDebounceBox" TextChanged="OnFieldChanged"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="组合键 (逗号分隔)" Style="{StaticResource PropertyLabel}"/>
                        <TextBox x:Name="TModifiersBox" TextChanged="OnFieldChanged" PlaceholderText="Ctrl,Shift"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="阈值 (px)" Style="{StaticResource PropertyLabel}"/>
                        <TextBox x:Name="TThresholdBox" TextChanged="OnFieldChanged"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="比较方式 (ValueChanged)" Style="{StaticResource PropertyLabel}"/>
                        <TextBox x:Name="TComparedBox" TextChanged="OnFieldChanged" PlaceholderText="equals/greater/less"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="时间点 (Time事件, 秒)" Style="{StaticResource PropertyLabel}"/>
                        <TextBox x:Name="TAtBox" TextChanged="OnFieldChanged"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="TOnceBox" Content="一次性触发" Checked="OnFieldChanged" Unchecked="OnFieldChanged"/>
                <CheckBox x:Name="TStopBox" Content="步数用完后停止" Checked="OnFieldChanged" Unchecked="OnFieldChanged"/>

                <TextBlock Text="条件表达式" Style="{StaticResource PropertyLabel}"/>
                <TextBox x:Name="TConditionBox" TextChanged="OnFieldChanged"/>

                <!-- Actions -->
                <TextBlock Text="动作列表" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,4"/>
                <ItemsControl x:Name="ActionsList" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ComboBox x:Name="ActType" MinWidth="140" FontSize="12" SelectionChanged="OnActionFieldChanged"/>
                                        <TextBox x:Name="ActTarget" Width="100" FontSize="12" PlaceholderText="target" TextChanged="OnActionFieldChanged"/>
                                        <Button Content="×" Width="24" Height="24" FontSize="12" Click="OnRemoveAction"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ActParams" Spacing="2"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ 添加动作" HorizontalAlignment="Stretch" Click="OnAddAction"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
