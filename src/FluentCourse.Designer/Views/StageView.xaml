<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentCourse.Designer.Views.StageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF1E1E1E">

    <Border x:Name="StageContainer" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#FF2A2A2A" BorderBrush="#44FFFFFF" BorderThickness="1"
            Margin="16">
        <Grid>
            <Viewbox x:Name="StageScaler" Stretch="Uniform">
                <Grid x:Name="StageRoot" Width="1920" Height="1080">
                    <Canvas x:Name="AdornerCanvas" Width="1920" Height="1080" IsHitTestVisible="False">
                        <!-- Selection overlay: border + handles -->
                        <Border x:Name="SelectionBorder" Style="{StaticResource SelectionAdornerBorder}"
                                Visibility="Collapsed"/>
                        <Rectangle x:Name="HandleTL" Style="{StaticResource SelectionHandle}" Visibility="Collapsed"/>
                        <Rectangle x:Name="HandleTR" Style="{StaticResource SelectionHandle}" Visibility="Collapsed"/>
                        <Rectangle x:Name="HandleBL" Style="{StaticResource SelectionHandle}" Visibility="Collapsed"/>
                        <Rectangle x:Name="HandleBR" Style="{StaticResource SelectionHandle}" Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </Viewbox>
            <Border x:Name="ErrorOverlay" Background="#CC000000" Visibility="Collapsed"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock x:Name="ErrorText" Foreground="#FFFF6B6B" FontSize="16"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="40"
                           FontFamily="Cascadia Mono, Consolas, monospace"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
