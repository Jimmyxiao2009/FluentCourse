<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FluentCourse.Designer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 调色板 (Fluent 风格) — 颜色直接写入画刷，WinUI 3 XAML 编译器不支持独立的 <Color> 资源元素 -->
            <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#FF1F1F23"/>
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF2A2A30"/>
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#FF16161A"/>
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF3A3A42"/>
            <SolidColorBrush x:Key="StrokeSubtleBrush" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="StrokeDefaultBrush" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="StrokeStrongBrush" Color="#66FFFFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF"/>
            <SolidColorBrush x:Key="AccentStrongBrush" Color="#FF0099FF"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B6B"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FFFFB84C"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF66E099"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F7"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB0B0B8"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF7A7A82"/>

            <!-- 通用文本样式 -->
            <Style x:Key="H1Text" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="H2Text" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </Style>
            <Style x:Key="MonoText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- 面板容器 -->
            <Style x:Key="PanelSurface" TargetType="Grid">
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            </Style>
            <Style x:Key="PanelSurfaceBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
            </Style>
            <Style x:Key="PanelHeader" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>
            <Style x:Key="PanelAccentBar" TargetType="Border">
                <Setter Property="Height" Value="2"/>
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <!-- 拖动分隔条 (panel splitter) -->
            <Style x:Key="PanelSplitterHorizontal" TargetType="Border">
                <Setter Property="Width" Value="4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1,0,0,0"/>
            </Style>
            <Style x:Key="PanelSplitterVertical" TargetType="Border">
                <Setter Property="Height" Value="4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
            </Style>

            <!-- 选择装饰 (StageView) -->
            <Style x:Key="SelectionAdornerBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>
            <Style x:Key="SelectionHandle" TargetType="Rectangle">
                <Setter Property="Width" Value="11"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="Fill" Value="White"/>
                <Setter Property="Stroke" Value="{StaticResource AccentStrongBrush}"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <!-- Hit-test enabled so the handles can be grabbed to resize. -->
            </Style>
            <Style x:Key="SnapGuideLine" TargetType="Line">
                <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeDashArray" Value="3,2"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>

            <!-- 工具箱卡片 -->
            <Style x:Key="ToolboxCard" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
            </Style>

            <!-- 诊断条 -->
            <Style x:Key="DiagnosticBar" TargetType="Border">
                <Setter Property="Background" Value="#33FF6B6B"/>
                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Setter Property="Padding" Value="12,6"/>
            </Style>

            <!-- 属性表 -->
            <Style x:Key="PropertyLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,6,0,2"/>
            </Style>
            <Style x:Key="PropertyRowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="PropertyRowInput" TargetType="Control">
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <!-- Ribbon 按钮 -->
            <Style x:Key="RibbonButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <!-- Ribbon 大按钮 (图标 + 双行文字) -->
            <Style x:Key="RibbonLargeButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="MinWidth" Value="68"/>
                <Setter Property="MinHeight" Value="68"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RibbonSmallButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <!-- Ribbon 分组容器 -->
            <Style x:Key="RibbonGroup" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1,0,0,0"/>
                <Setter Property="Padding" Value="10,4,10,2"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <Style x:Key="RibbonGroupLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>

            <!-- 状态栏 -->
            <Style x:Key="StatusBarItem" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0"/>
            </Style>

            <!-- 命令栏紧凑按钮 (图标 + 小标签，竖排) -->
            <Style x:Key="CmdBarButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- 插入条按钮 (图标 + 标签，竖排，宽度自适应) -->
            <Style x:Key="InsertButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="MinWidth" Value="54"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- 右面板标签按钮 (仅图标，正方形) -->
            <Style x:Key="PanelTabButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- 拖拽幽灵层 -->
            <Style x:Key="DragGhost" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Opacity" Value="0.85"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <x:Boolean x:Key="TrueValue">True</x:Boolean>
            <x:Boolean x:Key="FalseValue">False</x:Boolean>
        </ResourceDictionary>
    </Application.Resources>
</Application>
