<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentCourse.Designer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentCourse.Designer.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Command Bar -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
            <AppBarButton x:Name="NewButton" Icon="NewWindow" Label="新建" Click="OnNewClicked"/>
            <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="打开" Click="OnOpenClicked"/>
            <AppBarButton x:Name="SaveButton" Icon="Save" Label="保存" Click="OnSaveClicked"/>
            <AppBarButton x:Name="SaveAsButton" Icon="SaveLocal" Label="另存为" Click="OnSaveAsClicked"/>
            <AppBarButton x:Name="ExportButton" Icon="Upload" Label="导出.fcourse" Click="OnExportClicked"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="UndoButton" Icon="Undo" Label="撤销" Click="OnUndoClicked"/>
            <AppBarButton x:Name="RedoButton" Icon="Redo" Label="重做" Click="OnRedoClicked"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="PreviewButton" Icon="Play" Label="预览" Click="OnPreviewClicked"/>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left pane -->
            <NavigationView x:Name="LeftNav" Grid.Column="0"
                            IsPaneOpen="True" IsSettingsVisible="False"
                            CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="260"
                            PaneDisplayMode="Top" SelectionChanged="OnLeftNavSelectionChanged"
                            IsBackEnabled="False" OpenPaneLength="260">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="页面" Tag="Pages" Icon="List"/>
                    <NavigationViewItem Content="设置" Tag="Settings" Icon="Setting"/>
                    <NavigationViewItem Content="资源" Tag="Assets" Icon="Library"/>
                </NavigationView.MenuItems>
                <Frame x:Name="LeftFrame"/>
            </NavigationView>

            <!-- Center -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <AppBarButton x:Name="DesignTabButton" Icon="PreviewLink" Label="设计" Click="OnDesignTabClicked"/>
                    <AppBarButton x:Name="XamlTabButton" Icon="Font" Label="XAML" Click="OnXamlTabClicked"/>
                    <AppBarSeparator/>
                    <AppBarButton x:Name="AddPageButton" Icon="Add" Label="加页" Click="OnAddPageClicked"/>
                </CommandBar>

                <Grid Grid.Row="1">
                    <Grid x:Name="DesignSurfacePanel" Visibility="Visible">
                        <local:StageView x:Name="StageViewControl"/>
                    </Grid>
                    <local:XamlCodeView x:Name="CodeView" Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <!-- Right pane -->
            <Grid Grid.Column="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <TabView Grid.Row="0" TabWidthMode="SizeToContent" SelectedIndex="0">
                    <TabViewItem Header="属性">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <local:PropertiesPane x:Name="PropertiesPaneView"/>
                        </ScrollViewer>
                    </TabViewItem>
                    <TabViewItem Header="页面">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <local:PagePropertiesView x:Name="PagePropsView"/>
                        </ScrollViewer>
                    </TabViewItem>
                    <TabViewItem Header="工具箱">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <local:ToolboxPane x:Name="ToolboxPaneView"/>
                        </ScrollViewer>
                    </TabViewItem>
                    <TabViewItem Header="触发器">
                        <local:TriggerEditor x:Name="TriggerEditorView"/>
                    </TabViewItem>
                    <TabViewItem Header="动画">
                        <local:AnimationEditor x:Name="AnimationEditorView"/>
                    </TabViewItem>
                </TabView>
            </Grid>
        </Grid>

        <!-- Diagnostics -->
        <Border x:Name="DiagnosticsBar" Grid.Row="2" Style="{StaticResource DiagnosticBar}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DiagnosticsText" Foreground="#FFFF6B6B" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" FontSize="10" Click="OnDismissDiagnostics" Background="Transparent"/>
            </Grid>
        </Border>
    </Grid>
</Window>
