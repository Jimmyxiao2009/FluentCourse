<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentCourse.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    IsOpen="False"
                    IsDynamicOverflowEnabled="False">
            <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="打开" Click="OnOpenClicked"/>
            <AppBarButton x:Name="PrevButton" Icon="Previous" Label="上一页" Click="OnPrevClicked"/>
            <AppBarButton x:Name="NextButton" Icon="Next" Label="下一页" Click="OnNextClicked"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="OverviewButton" Icon="ViewAll" Label="页面概览" Click="OnOverviewClicked"/>
            <AppBarButton x:Name="PresenterButton" Icon="TwoPage" Label="演讲者视图" Click="OnPresenterClicked"/>
            <AppBarButton x:Name="FullscreenButton" Icon="FullScreen" Label="全屏" Click="OnFullscreenClicked"/>
        </CommandBar>

        <Grid Grid.Row="1">
            <ContentPresenter x:Name="StageHost"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>
            <TextBlock x:Name="EmptyHint"
                       Text="选择一个 .fcourse 文件开始"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       IsHitTestVisible="False"/>

            <!-- Page overview panel -->
            <Border x:Name="OverviewPanel"
                    Width="280"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="页面列表" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="16,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="PageListView"
                                  SelectionMode="Single"
                                  SelectionChanged="OnPageListSelectionChanged"
                                  Margin="8,0,8,8">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,8" Spacing="2">
                                        <TextBlock Text="{Binding Index}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
